{
  "name": "job-digest",
  "productName": "DevJob Digest",
  "version": "0.1.2",
  "description": "International Development Personal DevJob Digest — a free, local-first desktop app that searches senior international-development/AI-for-good roles, scores fit against your real CV, tracks applications, and drafts tailored CVs and cover letters. Runs entirely on your machine; uses your own Claude Code installation for all AI work.",
  "license": "MIT",
  "author": "ka-codes",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ka-codes.job-digest",
    "productName": "DevJob Digest",
    "asar": false,
    "directories": {
      "app": "."
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "skills/**/*",
      "scripts/**/*",
      "commands/**/*",
      "templates/**/*",
      "docs/**/*",
      ".claude-plugin/**/*",
      "!app/.config.json",
      "!app/*.log",
      "!app/*.pid"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
