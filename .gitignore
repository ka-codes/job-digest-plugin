applications.json
profile.md
settings.json
digest-run-log.txt
last-run-log.txt
cover-letters/
cv-tailored/

# Local dev-tool scratch directories
.taste-skill/
.impeccable/

# OS cruft
.DS_Store
Thumbs.db
